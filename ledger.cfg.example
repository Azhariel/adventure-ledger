# Copy to ledger.cfg (git ignores it) and set your paths.
# wow: the WoW Forever folder that holds WTF, Interface, Logs and Screenshots.
wow = C:\Program Files (x86)\World of Warcraft\_forever_
# data: where the built page, price logs, neutral_days.txt, zone maps and server.log go (default: <repo>\data).
# data = D:\ledger-data

# --- Auction house prices from the Battle.net API (optional) ---
# Without these lines everything else works as before; the tray shows the AH fetcher as "not set up".
#
# bnet_id, bnet_secret: create your own client at https://develop.battle.net (each user needs their own; never
#   share or commit them). Only the client credentials flow is used, so no redirect URL or service URL is needed.
# bnet_id = your-client-id
# bnet_secret = your-client-secret
#
# bnet_region: the Battle.net region your characters play on: us or eu.
# bnet_region = us
#
# ah_houses: the auction houses to fetch, one entry per ruleset and side, comma-separated. Each entry is the
#   ruleset name followed by the house id:  ah_houses = PvP 113, PvP 116, Roleplay PvP 119
#   The ruleset name is the one the dashboard shows for your character. Only "PvP" is verified so far; other
#   names (Normal, Roleplay, Roleplay PvP) are passed through as you write them. Houses are never merged across
#   entries: "PvP Horde" and "Roleplay PvP Horde" are separate.
#   The side comes from the id, you don't write it. The houses come in sets of three (Alliance / Horde /
#   Neutral, the Blackwater goblin one): 110/113/116, 111/114/117, 119/120/121, 123/124/125 (112, 115 and 118
#   are empty). Horde on the PvP ruleset matched 113, and its Neutral house matched 116.
#   The API doesn't say which house is whose, so find yours by matching against your own scans:
#     1. Scan the AH in game (Auctionator), then /reload so the scan is saved.
#     2. Run  python dashboard\fetcher.py --match faction   (or  --match neutral  after a scan at Booty Bay,
#        Gadgetzan, Everlook or the Barrens AH outside the Crossroads). It ranks every house by how many prices
#        match yours and names the best one.
#   The old keys ah_ruleset (1 = PvP, 2 = Normal, 3 = Roleplay, 15 = Roleplay PvP), ah_faction and ah_neutral
#   still work when ah_houses is not set (defaults 1, 113 and 116).
# ah_houses = PvP 113, PvP 116
#
# ah_reset: the weekly reset, as a day and an hour on your own clock: Tue 12, tuesday 12:00 (English day names or
#   3-letter abbreviations, any case; whole hours only). Default: Tuesday at the local hour of 15:00 UTC, the US
#   reset. Set it if Forever resets at another time. The dashboard outlines this hour in every grid.
# ah_reset = Tue 12
#
# ah_every: minutes between checks (default 10). Blizzard makes a new snapshot about hourly, at no fixed minute
#   (not documented). Each check asks only for data newer than the last snapshot: when there is none, Blizzard
#   answers "not modified" and nothing is downloaded. A new snapshot downloads both houses (about 15-20 MB) and is
#   dated by when Blizzard made it. Checking often catches each snapshot soon after it appears. Don't set 0.
# ah_every = 10

# --- Sync between PCs through a Backblaze B2 bucket (optional; the Sync page) ---
# Without these lines the Sync page says "not set up" and nothing else changes. See README, "Playing on more
# than one PC". Never share or commit the key.
#
# b2_key_id, b2_key: an application key restricted to the one bucket, with listFiles, readFiles and writeFiles.
#   One key per PC. b2_bucket: the private bucket's name.
# b2_key_id = your-key-id
# b2_key = your-application-key
# b2_bucket = your-bucket
#
# pc_name: this PC's name in the bucket and in the other PC's data\pcs folder (default: the computer name,
#   lower-cased). Use the name the other PC already has a copy under, if it has one.
# pc_name = home-pc
#
# market_master: yes on the PC whose market.db the others take (the one that's on the most). It uploads its
#   market db every day at 08:00 and never imports one. Leave it out on every other PC.
# market_master = yes
