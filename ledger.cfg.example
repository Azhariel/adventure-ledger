# Copy to ledger.cfg (git ignores it) and set your paths.
# wow: the WoW Forever folder that holds WTF, Interface, Logs and Screenshots.
wow = C:\Program Files (x86)\World of Warcraft\_forever_
# data: where the built page, price logs, neutral_days.txt, zone maps and server.log go (default: <repo>\data).
# data = D:\ledger-data

# --- Auction house prices from the Battle.net API (optional) ---
# Without these lines everything else works as before; the tray shows the AH fetcher as "not set up".
#
# bnet_id, bnet_secret: create your own client at https://develop.battle.net (each user needs their own; never
#   share or commit them). Only the client credentials flow is used, so no redirect URL or service URL is needed.
# bnet_id = your-client-id
# bnet_secret = your-client-secret
#
# bnet_region: the Battle.net region your characters play on: us or eu.
# bnet_region = us
#
# ah_ruleset: the ruleset your characters are on. Forever has rulesets instead of realms:
#   1 = PvP, 2 = Normal, 3 = Roleplay, 15 = Roleplay PvP.
#   The API currently returns the same auction houses for every ruleset, so this rarely matters; set it anyway.
# ah_ruleset = 1
#
# ah_faction, ah_neutral: the IDs of the two auction houses you trade at, your faction's and the Blackwater
#   (goblin) one. The API doesn't say which house is whose, so find them by matching against your own scans:
#     1. Scan the AH in game (Auctionator), then /reload so the scan is saved.
#     2. Run  python dashboard\fetcher.py --match faction   (or  --match neutral  after a scan at Booty Bay,
#        Gadgetzan, Everlook or the Barrens AH outside the Crossroads). It ranks every house by how many prices
#        match yours and names the best one.
#   The houses come in sets of three (Alliance / Horde / Blackwater): 110/113/116, 111/114/117, 119/120/121,
#   123/124/125 (112, 115 and 118 are empty). Horde on the PvP ruleset matched 113, and its Blackwater house
#   matched 116.
# ah_faction = 113
# ah_neutral = 116
#
# ah_every: minutes between checks (default 10). Blizzard makes a new snapshot about hourly, at no fixed minute
#   (not documented). Each check asks only for data newer than the last snapshot: when there is none, Blizzard
#   answers "not modified" and nothing is downloaded. A new snapshot downloads both houses (about 15-20 MB) and is
#   dated by when Blizzard made it. Checking often catches each snapshot soon after it appears. Don't set 0.
# ah_every = 10
